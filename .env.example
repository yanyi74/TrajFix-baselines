# Copy to .env and supply your OpenAI-compatible gateway configuration.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-gateway.example/v1
TRAJFIX_SMOKE_MODEL=openai/deepseek-v4-pro

# Optional: load credentials from an existing, untracked dotenv file.
# TRAJFIX_CREDENTIALS_FILE=/absolute/path/to/credentials.env
# AIHUB_API_KEY and AIHUB_BASE_URL are also accepted.
